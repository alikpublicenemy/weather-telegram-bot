# Вставь токен, полученный у @BotFather
BOT_TOKEN=ВСТАВЬ_ТОКЕН_БОТА

# Твой числовой Telegram ID
TELEGRAM_USER_ID=ВСТАВЬ_СВОЙ_ID

# Погода по умолчанию для Нюрнберга
CITY=Нюрнберг
LATITUDE=49.4521
LONGITUDE=11.0767
TIMEZONE=Europe/Berlin

# Публичная ссылка WebUntis. Для GitHub храни её в Secrets, а не в файлах репозитория.
WEBUNTIS_PUBLIC_URL=ВСТАВЬ_ССЫЛКУ_ОБЩЕДОСТУПНОГО_РАСПИСАНИЯ
