# Эти значения нужны только для локального запуска. Не загружай настоящий .env в GitHub.
BOT_TOKEN=ВСТАВЬ_ТОКЕН_ОТ_BOTFATHER
TELEGRAM_USER_ID=ВСТАВЬ_СВОЙ_ЧИСЛОВОЙ_ID

# Для личного расписания WebUntis (пароль хранить только в локальном .env или GitHub Secrets)
WEBUNTIS_USERNAME=ТВОЙ_ЛОГИН_WEBUNTIS
WEBUNTIS_PASSWORD=ТВОЙ_ПАРОЛЬ_WEBUNTIS

# Погода по умолчанию для Нюрнберга
CITY=Нюрнберг
LATITUDE=49.4521
LONGITUDE=11.0767
TIMEZONE=Europe/Berlin
